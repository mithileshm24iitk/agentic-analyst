# Copy this file to .env and fill in your values. .env is git-ignored.

# Google Cloud project that pays for Gemini calls.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Where Gemini is called. "global" is the endpoint with the widest model access.
GOOGLE_CLOUD_LOCATION=global

# true = call Gemini through Vertex AI (uses gcloud application-default credentials).
GOOGLE_GENAI_USE_ENTERPRISE=true

# Model used by worker agents. Swap freely, e.g. gemini-3.5-flash-lite.
WORKER_MODEL=gemini-3.8-flash

# BigQuery. Queries run (and are billed) in GOOGLE_CLOUD_PROJECT and read this dataset.
BQ_DATASET=bigquery-public-data.thelook_ecommerce
# Must match where the dataset lives; the public dataset is in the US multi-region.
BQ_LOCATION=US
# Hard cap on bytes a single query may scan (1 GB).
BQ_MAX_BYTES_BILLED=1000000000
# LIMIT added to queries without one, and max rows returned.
BQ_MAX_ROWS=100
BQ_QUERY_TIMEOUT_SECONDS=30
# How many run_query calls the SQL agent gets per question.
SQL_MAX_ATTEMPTS=3

# RAG embeddings (Vertex AI). Changing model or dim rebuilds the vector store on the next ingest.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=global
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=50

# RAG retrieval
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
RAG_COLLECTION=shopco_docs
# Chunk size and overlap are in characters.
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RAG_TOP_K=5
# Reciprocal rank fusion constant: higher = flatter blend of the two rankings.
RRF_K=60

# Orchestrator and critic. Leave empty to use WORKER_MODEL.
ORCHESTRATOR_MODEL=
CRITIC_MODEL=
# How many times the orchestrator may revise after the critic finds unsupported claims.
CRITIC_MAX_REVISIONS=1
# Where save_report writes markdown files (git-ignored).
REPORTS_DIR=reports

# Timeouts: one model/embedding HTTP call, and one whole API request
# (keep the request timeout under Cloud Run's 300s default).
LLM_TIMEOUT_SECONDS=90
REQUEST_TIMEOUT_SECONDS=270

# Gemini thinking effort for every agent. gemini-3.8-flash supports LOW, MEDIUM, HIGH
# (the model's own default is MEDIUM). Empty = the model's default. Compare with make bench.
THINKING_LEVEL=

# Metrics: one JSON line per request (git-ignored).
METRICS_PATH=data/metrics/requests.jsonl
# Tracing: none (default), console, or gcp (Cloud Trace via telemetry.googleapis.com).
TRACING_EXPORTER=none
# make bench: how many times each benchmark question runs.
BENCH_RUNS=2
# Phase 6 evaluation harness settings.
# JUDGE_MODEL defaults to WORKER_MODEL when empty.
JUDGE_MODEL=
# Optional System D stronger orchestrator model (e.g. gemini-4-argon or gemini-3.1-pro-preview).
STRONG_ORCHESTRATOR_MODEL=gemini-4-argon
EVAL_CONCURRENCY=4
EVAL_MAX_DROP_POINTS=10.0
# Optional: override the price table (USD per 1M tokens). Unknown models report cost null.
# MODEL_PRICES={"gemini-3.8-flash": {"input_per_1m": 0.75, "output_per_1m": 3.75, "cached_input_per_1m": 0.075}}
