# Copy this file to .env and fill in your values. .env is git-ignored.

# Google Cloud project that pays for Gemini calls.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Where Gemini is called. "global" is the endpoint with the widest model access.
GOOGLE_CLOUD_LOCATION=global

# true = call Gemini through Vertex AI (uses gcloud application-default credentials).
GOOGLE_GENAI_USE_ENTERPRISE=true

# Model used by worker agents. Swap freely, e.g. gemini-3.5-flash-lite.
WORKER_MODEL=gemini-3.8-flash
