# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.
# Every setting is read by app/config.py. Real environment variables override .env.
# [required] = the app will not start without it. Everything else is optional and the
# value shown is the default (an empty value means "not set").

# ---------------------------------------------------------------- Google Cloud
# [required] Google Cloud project that pays for Gemini, embedding and BigQuery calls.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# [required] Where Gemini is called. "global" is the endpoint with the widest model access.
GOOGLE_CLOUD_LOCATION=global

# true = call Gemini through Vertex AI (uses gcloud application-default credentials).
GOOGLE_GENAI_USE_ENTERPRISE=true

# ---------------------------------------------------------------- Models
# [required] Model used by the worker agents (rag_agent, sql_agent). Swap freely, e.g. gemini-3.5-flash-lite.
WORKER_MODEL=gemini-3.8-flash
# Orchestrator and critic models. Leave empty to use WORKER_MODEL.
ORCHESTRATOR_MODEL=
CRITIC_MODEL=
# Gemini thinking effort for every agent. gemini-3.8-flash supports LOW, MEDIUM, HIGH
# (the model's own default is MEDIUM). Empty = the model's default. Compare with make bench.
THINKING_LEVEL=
# Override the price table (USD per 1M tokens) as JSON. Unknown models report cost null.
# Default: the table in app/config.py (DEFAULT_MODEL_PRICES).
# MODEL_PRICES={"gemini-3.8-flash": {"input_per_1m": 0.75, "output_per_1m": 3.75, "cached_input_per_1m": 0.075}}

# ---------------------------------------------------------------- BigQuery (sql_agent)
# Queries run (and are billed) in GOOGLE_CLOUD_PROJECT and read this dataset.
BQ_DATASET=bigquery-public-data.thelook_ecommerce
# Must match where the dataset lives; the public dataset is in the US multi-region.
BQ_LOCATION=US
# Hard cap on bytes a single query may scan, checked with a dry run (1 GB).
BQ_MAX_BYTES_BILLED=1000000000
# LIMIT added to queries without one (and clamped when larger), and max rows returned.
BQ_MAX_ROWS=100
BQ_QUERY_TIMEOUT_SECONDS=30
# How many run_query calls the SQL agent gets per question.
SQL_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- RAG (rag_agent)
# [required] Embedding model and its location (Vertex AI).
# Changing model or dim rebuilds the vector store on the next make ingest.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=global
EMBEDDING_DIM=768
# Texts per embedding request during ingest (Vertex allows up to 250).
EMBEDDING_BATCH_SIZE=50
# Source documents and the local index built by make ingest (git-ignored).
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
RAG_COLLECTION=shopco_docs
# Chunk size and overlap are in characters.
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Chunks returned per retrieve call.
RAG_TOP_K=5
# Reciprocal rank fusion constant: higher = flatter blend of the two rankings.
RRF_K=60

# ---------------------------------------------------------------- Orchestrator, critic, reports
# How many times the orchestrator may revise after the critic finds unsupported claims.
CRITIC_MAX_REVISIONS=1
# Where save_report writes markdown files locally (git-ignored).
REPORTS_DIR=reports
# Cloud Run: save_report writes to this Cloud Storage bucket instead (object name only in
# the response). Leave empty locally.
REPORTS_BUCKET=

# ---------------------------------------------------------------- Timeouts
# One model/embedding HTTP call, and one whole API request
# (keep the request timeout under Cloud Run's 300s default).
LLM_TIMEOUT_SECONDS=90
REQUEST_TIMEOUT_SECONDS=270

# ---------------------------------------------------------------- Metrics and tracing
# Metrics: one JSON line per request (git-ignored). Also printed to stdout.
METRICS_PATH=data/metrics/requests.jsonl
# Tracing: none (default), console, or gcp (Cloud Trace via telemetry.googleapis.com).
TRACING_EXPORTER=none
# make bench: how many times each benchmark question runs.
BENCH_RUNS=2

# ---------------------------------------------------------------- Evaluation (make eval)
# Model for the LLM judge. Empty = WORKER_MODEL.
JUDGE_MODEL=
# Optional orchestrator model for System D (must be set if evaluating System D).
# STRONG_ORCHESTRATOR_MODEL=
# Questions evaluated in parallel.
EVAL_CONCURRENCY=4
# make eval-check fails if success drops more than this many percentage points vs eval/baseline.json.
EVAL_MAX_DROP_POINTS=10.0

# ---------------------------------------------------------------- Security
# development: API_KEY optional (empty = open API, local only).
# production: API_KEY required (at least 32 characters); the app refuses to start without
# one. The Docker image defaults to production.
APP_ENV=development
# Clients send it in the X-API-Key header. On Cloud Run it comes from Secret Manager.
# Generate one with: openssl rand -hex 32. Never put a real production key in a file.
API_KEY=
# Longest question accepted by /ask, /ask/sql and /ask/rag (characters).
MAX_QUESTION_CHARS=2000
